NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
RUN_STARTUP_MIGRATIONS=true

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters

# Public app and CORS
PUBLIC_APP_URL=https://your-render-service.onrender.com
ALLOWED_ORIGINS=https://your-render-service.onrender.com

# Billing automation
BILLING_LIFECYCLE_AUTOMATION=true
BILLING_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_INTERVAL_ENGINE=false

# Stripe live or test mode. Keep every Stripe value from the same mode.
# Each STRIPE_PRICE_* value MUST be a distinct Stripe Price ID. Startup will
# refuse to boot if any two of these resolve to the same id (would cause
# silent plan misclassification in checkout and webhook handling).
STRIPE_SECRET_KEY=replace-with-stripe-secret-key-from-one-mode
STRIPE_WEBHOOK_SECRET=replace-with-webhook-signing-secret-from-the-same-mode
STRIPE_PRICE_BASIC=replace-with-basic-monthly-price-id
STRIPE_PRICE_PRO=replace-with-pro-monthly-price-id
STRIPE_PRICE_BUSINESS=replace-with-business-monthly-price-id
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Email. Required if password reset or outbound billing email is enabled.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
RESEND_API_KEY=

# Maintenance and seeding must stay disabled in production.
ALLOW_MAINTENANCE_ROUTES=false
ALLOW_SEED_ADMIN=false

# Uploads.
# Default UPLOAD_STORAGE_DRIVER=local writes to public/uploads (good for dev,
# ephemeral on Render). Set UPLOAD_STORAGE_DRIVER=r2 to publish job photos and
# company logos to Cloudflare R2 via the S3-compatible API.
#
# When UPLOAD_STORAGE_DRIVER=r2, ALL of the R2_* values below are required and
# the app will refuse to boot in production if any are missing.
#   - R2_ACCOUNT_ID         Cloudflare account id (Cloudflare Dashboard → R2)
#   - R2_ACCESS_KEY_ID      R2 API token "Access Key ID"
#   - R2_SECRET_ACCESS_KEY  R2 API token "Secret Access Key"
#   - R2_BUCKET             Bucket name (must exist; create in Cloudflare R2)
#   - R2_PUBLIC_BASE_URL    Bucket's public base URL with NO trailing slash.
#                           Either the r2.dev hostname (e.g.
#                           https://pub-<hash>.r2.dev) or your custom domain
#                           (e.g. https://media.example.com). The bucket must
#                           be configured to serve these objects publicly.
UPLOAD_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
