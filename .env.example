NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
RUN_STARTUP_MIGRATIONS=true

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters

# Public app and CORS
PUBLIC_APP_URL=https://your-render-service.onrender.com
ALLOWED_ORIGINS=https://your-render-service.onrender.com

# Billing automation
BILLING_LIFECYCLE_AUTOMATION=true
BILLING_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_INTERVAL_ENGINE=false

# Stripe live or test mode. Keep every Stripe value from the same mode.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key-from-one-mode
STRIPE_WEBHOOK_SECRET=replace-with-webhook-signing-secret-from-the-same-mode
STRIPE_PRICE_BASIC=replace-with-basic-monthly-price-id
STRIPE_PRICE_PRO=replace-with-pro-monthly-price-id
STRIPE_PRICE_BUSINESS=replace-with-business-monthly-price-id
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Email. Required if password reset or outbound billing email is enabled.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
RESEND_API_KEY=

# Maintenance and seeding must stay disabled in production.
ALLOW_MAINTENANCE_ROUTES=false
ALLOW_SEED_ADMIN=false

# Uploads currently use local disk at public/uploads.
# On Render this is ephemeral unless you add persistent/external storage.
UPLOAD_STORAGE_DRIVER=local
